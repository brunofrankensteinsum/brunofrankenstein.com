// Configuración de Cloudflare.
// - El sitio ya compilado está en la carpeta dist.
// - worker/index.js atiende solo las direcciones /api/* (el formulario de contacto).
// - CORREO es el servicio con el que el formulario envía mensajes a Bruno (Cloudflare Email Routing).
// Los secretos (DESTINO, TURNSTILE_SECRET) NO van acá: se cargan en el panel de Cloudflare.
// Guía paso a paso: docs/formulario-contacto.md
{
  "name": "brunofrankenstein-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [{ "name": "CORREO" }],
  // Guarda los registros del Worker (errores del formulario) para poder consultarlos en el panel de Cloudflare.
  "observability": { "enabled": true },
  "vars": {
    // Dirección del dominio que figura como emisora de los avisos. No es tu correo personal.
    "REMITENTE": "formulario@brunofrankenstein.com"
  }
}
