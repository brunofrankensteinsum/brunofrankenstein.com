// Configuración de Cloudflare.
// - El sitio ya compilado está en la carpeta dist.
// - worker/index.js atiende solo las direcciones /api/* (el formulario de contacto).
// - CORREO es el servicio con el que el formulario envía mensajes a Bruno (Cloudflare Email Routing).
// Los secretos (DESTINO, TURNSTILE_SECRET) NO van acá: se cargan en el panel de Cloudflare.
// Guía paso a paso: docs/formulario-contacto.md
{
  "name": "brunofrankenstein-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Una dirección que no existe muestra la página 404 del diseño (dist/404.html) en vez de una página en blanco.
    "not_found_handling": "404-page"
  },
  "send_email": [{ "name": "CORREO" }],
  // Guarda los registros del Worker (errores del formulario) para poder consultarlos en el panel de Cloudflare.
  "observability": { "enabled": true },
  "vars": {
    // Dirección del dominio que figura como emisora de los avisos. No es tu correo personal.
    "REMITENTE": "formulario@brunofrankenstein.com"
  },
  // Vistas previas de las ramas (no son el sitio real). Cloudflare las despliega con `wrangler preview`,
  // que exige este bloque: sin él, el build de cualquier rama que no sea main falla en el paso de despliegue.
  // Las vistas previas no tienen los secretos (DESTINO, TURNSTILE_SECRET), así que el formulario de contacto
  // no envía nada desde ahí; sirven para mirar el diseño y el contenido antes de unir a main.
  "previews": {
    "vars": {
      "REMITENTE": "vista-previa@brunofrankenstein.com"
    },
    "send_email": [{ "name": "CORREO" }]
  }
}
