---
// Genera una página por cada categoría, con su nombre en español en la URL.
import CategoryPage from '../../../../components/pages/CategoryPage.astro';
import { categories } from '../../../../config/site';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { categoria: c.slug.es }, props: { categoryId: c.id } }));
}

const { categoryId } = Astro.props;
---

<CategoryPage lang="es" categoryId={categoryId} />
