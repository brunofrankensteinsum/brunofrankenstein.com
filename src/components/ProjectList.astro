---
// Lista de proyectos: número de lámina, fecha, título, resumen y categorías.
// Versión provisoria: en el paso 3 la reemplazan las tarjetas con portada.
import type { Lang } from '../config/site';
import { getCategory } from '../config/site';
import { projectUrl } from '../config/routes';
import { t, formatDate } from '../i18n/ui';
import { figLabel, type Project, type UpcomingProject } from '../lib/content';

interface Props {
  lang: Lang;
  projects: Project[];
  // Láminas en preparación: se anuncian al final, sin link.
  upcoming?: UpcomingProject[];
}

const { lang, projects, upcoming = [] } = Astro.props;
---

{
  projects.length === 0 && upcoming.length === 0 ? (
    <p class="vacio rotulo">{t(lang, 'projects.empty')}</p>
  ) : (
    <ul class="lista">
      {projects.map((p) => (
        <li>
          <p class="rotulo rotulo--acento">
            FIG. {figLabel(p.data.fig)} · {formatDate(lang, p.data.date)}
          </p>
          <h3>
            <a href={projectUrl(lang, p.slug)}>{p.data.title}</a>
          </h3>
          <p>{p.data.summary}</p>
          <p class="categorias">{p.data.categories.map((id) => getCategory(id)?.name[lang]).join(' · ')}</p>
        </li>
      ))}
      {upcoming.map((p) => (
        <li class="preparacion">
          <p class="rotulo">
            FIG. {figLabel(p.data.fig)} · {t(lang, 'project.upcoming')}
          </p>
        </li>
      ))}
    </ul>
  )
}

<style>
  .lista {
    border: 1px solid var(--c-line);
    background: var(--c-paper);
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--s-5) var(--s-6);
  }
  li + li { border-top: 1px dashed var(--c-line); }
  h3 {
    font-size: var(--fs-h3);
    line-height: 1.25;
    font-weight: 600;
  }
  .categorias {
    font-size: var(--fs-small);
    color: var(--c-ink-muted);
  }
  /* Estado vacío: marco punteado con el aviso en el medio. */
  .vacio {
    padding: var(--s-12) var(--s-6);
    border: 1px dashed var(--c-line);
    text-align: center;
  }
</style>
