---
// Cabecera SEO de cada página: lo que leen los buscadores, las redes y los asistentes de IA.
// Las páginas no la usan directo: la invoca el layout (src/layouts/Base.astro).
// Incluye los datos estructurados JSON-LD (src/lib/seo.ts) y la imagen para compartir de cada página.
// Pendiente (ver TAREAS.md): una imagen para compartir por defecto en las páginas que no tienen una (E6).
import { site, defaultLang, type Lang } from '../../config/site';
import { otherLang } from '../../config/routes';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  // URL de esta misma página en el otro idioma. Sin ella, la página existe en un solo idioma.
  alternateUrl?: string;
  // true = pedirle a los buscadores que no guarden esta página (por ejemplo, un listado vacío).
  noindex?: boolean;
  // "article" para un proyecto; "website" para el resto.
  type?: 'website' | 'article';
  // Datos estructurados de la página (resultado de grafo() en src/lib/seo.ts).
  jsonld?: object;
  // Dirección absoluta de la imagen para compartir (1200 × 630). Sin ella, la tarjeta no lleva imagen.
  image?: string;
}

const { lang, title, description, alternateUrl, noindex = false, type = 'website', jsonld, image } = Astro.props;
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
const absoluta = (ruta: string) => new URL(ruta, site.url).href;
const canonical = absoluta(Astro.url.pathname);

// Versiones de la página por idioma, para la etiqueta hreflang.
const other = otherLang(lang);
const versiones: Partial<Record<Lang, string>> = { [lang]: canonical };
if (alternateUrl) versiones[other] = absoluta(alternateUrl);
// x-default: la versión que se ofrece a quien no habla ninguno de los dos idiomas.
const porDefecto = versiones[defaultLang] ?? canonical;

// site.indexable apaga la indexación de todo el sitio (ver src/config/site.ts).
const ocultar = noindex || !site.indexable;
const locale = { es: 'es_UY', en: 'en_US' } as const;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{ocultar && <meta name="robots" content="noindex, follow" />}

{/* Idiomas: le dice a los buscadores cuál es la versión de esta página en cada idioma. */}
{Object.entries(versiones).map(([codigo, url]) => <link rel="alternate" hreflang={codigo} href={url} />)}
{alternateUrl && <link rel="alternate" hreflang="x-default" href={porDefecto} />}

{/* Open Graph: cómo se ve el link al compartirlo en LinkedIn, WhatsApp, etc. */}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={locale[lang]} />
{alternateUrl && <meta property="og:locale:alternate" content={locale[other]} />}
{image && <meta property="og:image" content={image} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
{/* JSON-LD: datos para máquinas, no se ven en la página. Se escapa «<» para que nada cierre el <script>. */}
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld).replace(/</g, '\\u003c')} />}

{/* Feed RSS de los proyectos, en el idioma de la página. */}
<link rel="alternate" type="application/rss+xml" title={`${site.name} · RSS`} href={`/${lang}/rss.xml`} />

{/* Ícono del sitio (se genera con scripts/generar-favicon.mjs). */}
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
