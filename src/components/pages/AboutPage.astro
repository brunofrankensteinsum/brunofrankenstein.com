---
// Sobre mí. Por ahora es una ruta vacía: el contenido llega en el paso 3.
import Base from '../../layouts/Base.astro';
import PageIntro from '../ui/PageIntro.astro';
import Placeholder from '../ui/Placeholder.astro';
import { site, type Lang } from '../../config/site';
import { pageUrl, otherLang } from '../../config/routes';
import { t } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const title = t(lang, 'about.title');
---

<Base lang={lang} title={title} description={site.tagline[lang]} section="about" alternateUrl={pageUrl(otherLang(lang), 'about')}>
  <PageIntro label={t(lang, 'about.label')} title={title} />
  <div class="container cuerpo">
    <Placeholder variant="punteado" ratio="21 / 9" label={t(lang, 'wip')} />
  </div>
</Base>

<style>
  .cuerpo { padding-block: var(--s-12) var(--s-18); }
</style>
