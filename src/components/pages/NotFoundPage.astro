---
// Página 404. Versión provisoria en los dos idiomas; el diseño definitivo es del paso 6.
import Base from '../../layouts/Base.astro';
import { defaultLang, languages } from '../../config/site';
import { pageUrl } from '../../config/routes';
import { t } from '../../i18n/ui';
---

<Base lang={defaultLang} title={t(defaultLang, 'notfound.title')} description={t(defaultLang, 'notfound.text')}>
  <div class="container cuerpo">
    <p class="rotulo rotulo--acento">{t(defaultLang, 'notfound.label')}</p>
    {
      languages.map((l) => (
        <section lang={l}>
          <h1 class="titulo-pagina">{t(l, 'notfound.title')}</h1>
          <p class="muted">{t(l, 'notfound.text')}</p>
          <p>
            <a class="volver" href={pageUrl(l, 'home')}>
              {t(l, 'notfound.back')}
            </a>
          </p>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .cuerpo {
    display: flex;
    flex-direction: column;
    gap: var(--s-10);
    padding-block: var(--s-16) var(--s-18);
  }
  section {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  /* El segundo idioma va más chico: es la misma información repetida. */
  section + section .titulo-pagina { font-size: var(--fs-h2); }
  .volver {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--c-accent);
  }
</style>
