---
// Listado de todos los proyectos. Versión mínima de la etapa 1; la completa la pista A.
import Base from '../../layouts/Base.astro';
import ProjectList from '../ProjectList.astro';
import type { Lang } from '../../config/site';
import { pageUrl, otherLang } from '../../config/routes';
import { t } from '../../i18n/ui';
import { getProjects } from '../../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const projects = await getProjects(lang);
const title = t(lang, 'projects.title');
---

<Base lang={lang} title={title} description={title} alternateUrl={pageUrl(otherLang(lang), 'projects')}>
  <h1>{title}</h1>
  <ProjectList lang={lang} projects={projects} />
</Base>
