---
// Página de un proyecto (una «lámina»): encabezado, portada, texto, cajetín,
// índice de secciones y navegación a otras láminas.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { getCategory, type Lang } from '../../config/site';
import { pageUrl, projectUrl, categoryUrl, otherLang } from '../../config/routes';
import { t, formatDay } from '../../i18n/ui';
import { figLabel, getProjects, projectExists, type Project } from '../../lib/content';
import { definicion, terminosEn } from '../../config/glossary.mjs';

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
const { data, slug } = project;
// Convierte el Markdown del proyecto en un componente; "headings" son sus subtítulos.
const { Content, headings } = await render(project);
// Secciones para el índice lateral: los subtítulos de nivel 2 (los "##" del Markdown).
const secciones = headings.filter((h) => h.depth === 2);

const other = otherLang(lang);
const alternateUrl = (await projectExists(other, slug)) ? projectUrl(other, slug) : undefined;

// Lámina anterior y siguiente, según el número de lámina.
const porFig = (await getProjects(lang)).sort((a, b) => a.data.fig - b.data.fig);
const pos = porFig.findIndex((p) => p.slug === slug);
const anterior = pos > 0 ? porFig[pos - 1] : undefined;
const siguiente = pos < porFig.length - 1 ? porFig[pos + 1] : undefined;

const dos = (n: number) => String(n).padStart(2, '0');
// Términos del glosario que aparecen en el texto: el script marca la primera aparición de cada uno.
const terminos = terminosEn(lang, project.body ?? '');
const primeraCategoria = data.categories[0];
---

<Base lang={lang} title={data.title} description={data.summary} section="projects" alternateUrl={alternateUrl} type="article">
  <header class="container cabecera" data-reveal>
    <nav class="ruta" aria-label={t(lang, 'project.breadcrumb')}>
      <a href={pageUrl(lang, 'projects')}>{t(lang, 'projects.title')}</a>
      {
        primeraCategoria && (
          <>
            <span aria-hidden="true">/</span>
            <a href={categoryUrl(lang, primeraCategoria)}>{getCategory(primeraCategoria)?.name[lang]}</a>
          </>
        )
      }
      <span aria-hidden="true">/</span>
      <span class="ruta__actual" aria-current="page">FIG. {figLabel(data.fig)}</span>
    </nav>
    <div class="cabecera__titulo">
      <h1>{data.title}</h1>
      <p>{data.summary}</p>
    </div>
    <div class="portada rayado" data-marco>
      <Image src={data.cover} alt={data.coverAlt} widths={[640, 960, 1280, 1920]} sizes="(min-width: 1280px) 1136px, 100vw" loading="eager" />
    </div>
  </header>

  <div class="container cuerpo">
    <article class="prosa" lang={lang} data-reveal>
      <Content />
      {
        data.youtube && (
          <>
            {/* Fachada del video: sin JavaScript es un link a YouTube; con JavaScript, el clic
                carga el reproductor acá mismo (src/scripts/lamina.ts). */}
            <a
              class="video rayado"
              href={`https://www.youtube.com/watch?v=${data.youtube}`}
              aria-label={t(lang, 'project.play')}
              data-video={data.youtube}
              data-titulo={data.title}
            >
              <span class="video__play">
                <Icon name="ui-play" />
              </span>
            </a>
            <p class="video__nota">{t(lang, 'project.videoNote')}</p>
          </>
        )
      }
    </article>

    <aside class="lateral" data-reveal>
      <dl class="cajetin caja">
        <div class="cajetin__titulo">{t(lang, 'project.titleBlock')}</div>
        <div class="cajetin__fila">
          <dt>{t(lang, 'project.date')}</dt>
          <dd class="cajetin__mono">{formatDay(data.date)}</dd>
        </div>
        <div class="cajetin__fila">
          <dt>{t(lang, 'project.category')}</dt>
          <dd>
            {
              data.categories.map((id, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={categoryUrl(lang, id)}>{getCategory(id)?.name[lang]}</a>
                </>
              ))
            }
          </dd>
        </div>
        {
          data.tags.length > 0 && (
            <div class="cajetin__fila">
              <dt>{t(lang, 'project.tags')}</dt>
              <dd class="cajetin__mono cajetin__tags">
                {
                  data.tags.map((tag, i) => {
                    const def = definicion(lang, tag);
                    return (
                      <>
                        {i > 0 && ' · '}
                        {def ? (
                          <button type="button" class="glosa" data-nota={def} data-nota-rotulo="Def.">
                            {tag}
                          </button>
                        ) : (
                          tag
                        )}
                      </>
                    );
                  })
                }
              </dd>
            </div>
          )
        }
      </dl>

      {
        secciones.length > 0 && (
          <nav class="toc" aria-label={t(lang, 'project.tocLabel')}>
            <p class="toc__titulo rotulo">{t(lang, 'project.toc')}</p>
            <ol class="toc__lista">
              {secciones.map((s, i) => (
                <li>
                  <a href={`#${s.slug}`}>
                    <span class="toc__num">{dos(i + 1)}</span>
                    <span>{s.text}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      {
        data.repo && (
          <Button href={data.repo} icon="ui-flecha" block>
            {t(lang, 'project.repoButton')}
          </Button>
        )
      }
    </aside>
  </div>

  <nav class="container otros" aria-label={t(lang, 'project.others')} data-reveal>
    <div class="otros__caja caja">
      {
        anterior && (
          <a href={projectUrl(lang, anterior.slug)}>
            <span class="otros__rotulo">
              ← FIG. {figLabel(anterior.data.fig)} · {t(lang, 'project.prev')}
            </span>
            <span class="otros__titulo">{anterior.data.title}</span>
          </a>
        )
      }
      {
        siguiente && (
          <a href={projectUrl(lang, siguiente.slug)} class:list={[anterior && 'otros--der']}>
            <span class="otros__rotulo">
              FIG. {figLabel(siguiente.data.fig)} · {t(lang, 'project.next')} →
            </span>
            <span class="otros__titulo">{siguiente.data.title}</span>
          </a>
        )
      }
      <a href={pageUrl(lang, 'projects')} class="otros--der">
        <span class="otros__rotulo otros__rotulo--acento">{t(lang, 'project.index')} →</span>
        <span class="otros__titulo">{t(lang, 'project.indexTitle')}</span>
      </a>
    </div>
  </nav>

  {/* Visor de imágenes a pantalla completa. Se abre al hacer clic en una imagen del texto. */}
  <dialog class="visor" id="visor" aria-label={t(lang, 'viewer.label')}>
    <div class="visor__barra">
      <p class="visor__rotulo">
        <span data-visor-det>DET. A</span> · <span data-visor-esc>{t(lang, 'footer.scale')}</span>
      </p>
      <div class="visor__botones">
        <button type="button" data-visor-prev aria-label={t(lang, 'viewer.prev')} data-nota="←" data-nota-rotulo={t(lang, 'shortcut')}>
          <Icon name="ui-flecha" class="visor__atras" />
        </button>
        <button type="button" data-visor-next aria-label={t(lang, 'viewer.next')} data-nota="→" data-nota-rotulo={t(lang, 'shortcut')}>
          <Icon name="ui-flecha" />
        </button>
        <button type="button" data-visor-cerrar aria-label={t(lang, 'viewer.close')} data-nota="Esc" data-nota-rotulo={t(lang, 'shortcut')}>
          <Icon name="ui-cerrar" />
        </button>
      </div>
    </div>
    <div class="visor__lienzo" data-visor-lienzo>
      <img data-visor-img alt="" draggable="false" />
    </div>
    <p class="visor__pie" data-visor-pie></p>
  </dialog>

  {/* Molde del botón «Copiar»: el script lo clona en cada bloque de código. */}
  <template id="tpl-copiar">
    <button class="copiar" type="button" data-copiado={t(lang, 'project.copied')}>
      <span data-copiar-texto>{t(lang, 'project.copy')}</span>
      <Icon name="ui-copiar" size={16} class="copiar__ico" />
      <Icon name="ui-check" size={16} class="copiar__ok" />
    </button>
  </template>
  <p class="aviso-vivo" aria-live="polite" data-aviso></p>
  {terminos.length > 0 && <script type="application/json" id="glosario" set:html={JSON.stringify(terminos)} />}
</Base>

<script>
  import '../../scripts/lamina.ts';
</script>

<style>
  /* ---------- Cabecera ---------- */
  .cabecera {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: var(--s-8);
  }
  .ruta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    color: var(--c-ink-muted);
  }
  .ruta a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    --ul-y: calc(50% + 0.8em);
  }
  .ruta__actual { color: var(--c-accent); }
  .cabecera__titulo {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
  }
  h1 {
    font-size: var(--fs-h1-sans);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .cabecera__titulo p {
    font-size: 18px;
    color: var(--c-ink-muted);
  }
  .portada {
    margin: var(--s-5) 8px 8px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    outline: 1px solid var(--c-line);
    outline-offset: 8px;
  }
  .portada :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Cuerpo: texto + columna lateral ---------- */
  .cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-10);
    padding-block: var(--s-10) var(--s-14);
  }
  /* En pantallas chicas el cajetín va arriba del texto. */
  .lateral {
    order: -1;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }
  .toc { display: none; }

  /* ---------- Texto largo ---------- */
  .prosa {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px var(--s-8);
    align-content: start;
    max-width: 720px;
    font-size: 18px;
    line-height: 1.65;
    counter-reset: seccion det;
  }
  /* Subtítulos numerados: «01 EL PROBLEMA». El número lo pone el CSS. */
  .prosa :global(h2) {
    margin-top: var(--s-6);
    font-family: var(--f-mono);
    font-weight: 400;
    font-size: var(--fs-h3);
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    counter-increment: seccion;
  }
  .prosa :global(h2:first-child) { margin-top: 0; }
  .prosa :global(h2)::before {
    content: counter(seccion, decimal-leading-zero) ' ';
    color: var(--c-accent);
  }
  .prosa :global(h3) {
    margin-top: var(--s-2);
    font-size: var(--fs-h3);
    line-height: 1.3;
    font-weight: 600;
  }
  .prosa :global(a) { color: var(--c-accent); }
  /* Listas con «+» en acento en lugar de punto. */
  .prosa :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    list-style: none;
  }
  .prosa :global(ul > li) {
    position: relative;
    padding-left: 28px;
  }
  .prosa :global(ul > li)::before {
    content: '+';
    position: absolute;
    left: 0;
    font-family: var(--f-mono);
    color: var(--c-accent);
  }
  .prosa :global(ol) {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-left: 28px;
  }
  .prosa :global(ol > li)::marker {
    font-family: var(--f-mono);
    color: var(--c-accent);
  }
  /* Figuras: un párrafo del Markdown que tiene una imagen. Si debajo de la imagen hay una
     línea en *cursiva*, es el pie de foto y lleva el rótulo «DET. A», «DET. B»… */
  .prosa :global(p:has(> img)) {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    margin: var(--s-3) var(--frame-offset) var(--s-2);
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--c-ink-muted);
  }
  .prosa :global(p:has(> img) br) { display: none; }
  .prosa :global(p > img) {
    width: 100%;
    outline: 1px solid var(--c-line);
    outline-offset: var(--frame-offset);
    background: repeating-linear-gradient(45deg, var(--c-hatch-a) 0 10px, var(--c-hatch-b) 10px 11px);
  }
  .prosa :global(p:has(> img) > em) {
    font-style: normal;
    counter-increment: det;
  }
  .prosa :global(p:has(> img) > em)::before {
    content: 'DET. ' counter(det, upper-alpha);
    margin-right: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    color: var(--c-accent);
  }
  /* Tablas: si no entran, hacen scroll horizontal dentro de su caja. */
  .prosa :global(table) {
    display: block;
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    border: 1px solid var(--c-line);
    background: var(--c-paper);
    font-size: 16px;
  }
  .prosa :global(th) {
    padding: 9px 14px;
    border-bottom: 1px solid var(--c-line);
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    text-align: left;
    color: var(--c-ink-muted);
  }
  .prosa :global(td) {
    padding: 9px 14px;
    border-top: 1px dashed var(--c-line);
  }
  .prosa :global(tbody tr:first-child td) { border-top: none; }
  .prosa :global(th + th),
  .prosa :global(td + td) { border-left: 1px dashed var(--c-line); }
  .prosa :global(td + td) { font-family: var(--f-mono); }
  /* Citas del Markdown (líneas que empiezan con ">") = notas de plano. */
  .prosa :global(blockquote) {
    padding: 14px var(--s-4);
    border: 1px dashed var(--c-accent);
    background: var(--c-paper);
    font-size: 16px;
  }
  .prosa :global(blockquote)::before {
    content: 'NOTA';
    display: block;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: var(--ls-label);
    color: var(--c-accent);
  }
  .prosa:lang(en) :global(blockquote)::before { content: 'NOTE'; }
  /* Código. */
  .prosa :global(pre) {
    margin: 0;
    padding: 18px var(--s-5);
    overflow-x: auto;
    background: var(--c-paper-deep);
    border: 1px solid var(--c-line);
    font-family: var(--f-mono);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .prosa :global(code) {
    font-family: var(--f-mono);
    font-size: 0.9em;
  }
  .prosa :global(pre code) { font-size: inherit; }
  /* Caja que arma el script alrededor de cada bloque de código, con el botón «Copiar». */
  .prosa :global(.codigo) {
    position: relative;
    min-width: 0;
  }
  .copiar {
    position: absolute;
    top: 0;
    right: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 36px;
    padding: 0 var(--s-3);
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    color: var(--c-ink-muted);
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color var(--t-micro) linear,
      border-color var(--t-micro) linear;
  }
  .copiar:focus-visible,
  .copiar--ok {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }
  @media (hover: hover) {
    .copiar:hover {
      border-color: var(--c-accent);
      color: var(--c-accent);
    }
  }
  /* Muestra el ícono de copiar o el de «listo», según el estado. */
  .copiar :global(.copiar__ok),
  .copiar--ok :global(.copiar__ico) { display: none; }
  .copiar--ok :global(.copiar__ok) { display: block; }
  /* Las imágenes del texto se pueden ampliar. */
  .prosa :global(img.ampliable) { cursor: zoom-in; }
  .prosa :global(img.ampliable:focus-visible) {
    outline: 2px solid var(--c-accent);
    outline-offset: var(--frame-offset);
  }

  /* Video: fachada con botón de play. */
  .video {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 6px var(--frame-offset) 0;
    aspect-ratio: 16 / 9;
    outline: 1px solid var(--c-line);
    outline-offset: var(--frame-offset);
  }
  .video__play {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border: 1px solid var(--c-accent);
    background: var(--c-paper);
    color: var(--c-accent);
  }
  /* El link no lleva subrayado: es una imagen. */
  a.video { background-image: none; }
  iframe.video {
    width: calc(100% - var(--frame-offset) * 2);
    border: 0;
  }
  .video__play {
    transition:
      background-color var(--t-micro) linear,
      color var(--t-micro) linear;
  }
  .video:focus-visible { outline: 2px solid var(--c-accent); }
  /* Con el mouse encima o con foco, el cuadrado del play se rellena de acento. */
  .video:focus-visible .video__play {
    background: var(--c-accent);
    color: var(--c-on-accent);
  }
  @media (hover: hover) {
    .video:hover .video__play {
      background: var(--c-accent);
      color: var(--c-on-accent);
    }
  }
  .video__nota {
    margin-top: var(--s-2);
    font-size: 15px;
    color: var(--c-ink-muted);
  }

  /* ---------- Cajetín ---------- */
  .cajetin { font-size: 15px; }
  .cajetin__titulo {
    padding: 10px 14px;
    border-bottom: 1px solid var(--c-line);
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-accent);
  }
  .cajetin__fila {
    display: flex;
    gap: var(--s-3);
    padding: 10px 14px;
  }
  .cajetin__fila + .cajetin__fila { border-top: 1px dashed var(--c-line); }
  .cajetin dt {
    flex: none;
    width: 88px;
    padding-top: 3px;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--c-ink-muted);
  }
  .cajetin dd a { color: var(--c-accent); }
  .cajetin__mono { font-family: var(--f-mono); }
  .cajetin__tags { font-size: 13px; }

  /* ---------- Índice de secciones ---------- */
  .toc {
    flex-direction: column;
    font-family: var(--f-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .toc__titulo {
    padding-bottom: var(--s-2);
    font-size: 11px;
    letter-spacing: 0.1em;
  }
  .toc__lista a {
    display: flex;
    gap: var(--s-3);
    align-items: center;
    min-height: 40px;
    padding-left: var(--s-3);
    border-left: 1px dashed var(--c-line);
  }
  .toc__lista a {
    background-image: none;
    transition:
      color var(--t-micro) linear,
      border-color var(--t-hover) var(--ease-out);
  }
  .toc__num { color: var(--c-ink-muted); }
  /* Sección que se está leyendo: acento y borde izquierdo continuo. La marca lamina.ts. */
  .toc__lista a[aria-current] {
    border-left-style: solid;
    border-left-color: var(--c-accent);
    color: var(--c-accent);
  }
  .toc__lista a[aria-current] .toc__num { color: var(--c-accent); }

  /* ---------- Otras láminas ---------- */
  .otros { padding-bottom: var(--s-20); }
  .otros__caja {
    display: grid;
    grid-template-columns: 1fr;
  }
  .otros__caja a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--s-5) var(--s-6);
  }
  .otros__caja a { background-image: none; }
  .otros__caja a + a { border-top: 1px dashed var(--c-line); }
  .otros__rotulo {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--c-ink-muted);
  }
  .otros__rotulo--acento { color: var(--c-accent); }
  .otros__titulo {
    font-size: 20px;
    font-weight: 600;
  }

  /* ---------- Visor de imágenes ---------- */
  .visor {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    /* Papel al 96 %: se adivina la página de atrás. */
    background: color-mix(in srgb, var(--c-paper) 96%, transparent);
    color: var(--c-ink);
  }
  .visor::backdrop { background: transparent; }
  .visor[open] {
    display: flex;
    flex-direction: column;
  }
  .visor__barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 56px;
