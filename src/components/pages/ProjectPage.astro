---
// Página de un proyecto. Versión provisoria sobre el layout nuevo: el detalle del diseño
// (cajetín, índice lateral, figuras, video con fachada) llega en el paso 3.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getCategory, type Lang } from '../../config/site';
import { projectUrl, otherLang } from '../../config/routes';
import { t, formatDate } from '../../i18n/ui';
import { projectExists, type Project } from '../../lib/content';

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
const { data, slug } = project;
// Convierte el Markdown del proyecto en un componente que se puede mostrar.
const { Content } = await render(project);

const other = otherLang(lang);
const alternateUrl = (await projectExists(other, slug)) ? projectUrl(other, slug) : undefined;
---

<Base lang={lang} title={data.title} description={data.summary} section="projects" alternateUrl={alternateUrl}>
  <article class="container proyecto">
    <p class="rotulo">
      {formatDate(lang, data.date)} · {data.categories.map((id) => getCategory(id)?.name[lang]).join(' · ')}
    </p>
    <h1>{data.title}</h1>
    <p class="resumen">{data.summary}</p>
    <Image class="portada" src={data.cover} alt={data.coverAlt} width={1200} loading="eager" />
    <div class="prosa">
      <Content />
      {
        data.youtube && (
          <div class="video">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${data.youtube}`}
              title={data.title}
              loading="lazy"
              allowfullscreen
            />
          </div>
        )
      }
      {
        data.repo && (
          <p>
            <a href={data.repo}>{t(lang, 'project.repo')}</a>
          </p>
        )
      }
    </div>
  </article>
</Base>

<style>
  .proyecto {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding-block: var(--s-12) var(--s-18);
  }
  h1 {
    max-width: 820px;
    font-size: var(--fs-h1-sans);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .resumen {
    max-width: 720px;
    font-size: 18px;
    color: var(--c-ink-muted);
  }
  .portada {
    width: 100%;
    margin-block: var(--s-6);
    outline: 1px solid var(--c-line);
    outline-offset: 8px;
  }
  /* Texto largo: columna de 720 px para que las líneas no sean demasiado anchas. */
  .prosa {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 720px;
    font-size: 18px;
    line-height: 1.65;
  }
  .prosa :global(h2) {
    margin-top: var(--s-6);
    font-family: var(--f-mono);
    font-weight: 400;
    font-size: var(--fs-h3);
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .prosa :global(a) { color: var(--c-accent); }
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    outline: 1px solid var(--c-line);
    outline-offset: var(--frame-offset);
  }
  .video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
