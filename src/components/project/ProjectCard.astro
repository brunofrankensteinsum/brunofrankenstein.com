---
// Tarjeta de proyecto: portada, número de lámina, fecha, título, resumen y categorías.
// Toda la tarjeta es un solo link: el del título, estirado con ::after.
import { Image } from 'astro:assets';
import { getCategory, type Lang } from '../../config/site';
import { projectUrl } from '../../config/routes';
import { t, formatMonth } from '../../i18n/ui';
import { figLabel, type Project } from '../../lib/content';

interface Props {
  lang: Lang;
  project: Project;
  heading?: 'h2' | 'h3'; // nivel del título según dónde se use
  size?: 'normal' | 'chica';
}

const { lang, project, heading: Titulo = 'h2', size = 'normal' } = Astro.props;
const { data, slug } = project;
const fig = `FIG. ${figLabel(data.fig)}`;
---

<article class:list={['tarjeta', `tarjeta--${size}`]} data-reveal>
  <div class="tarjeta__foto marco rayado">
    {/* alt vacío: el título de al lado ya dice qué es. */}
    <Image
      src={data.cover}
      alt=""
      widths={[400, 640, 960]}
      sizes="(min-width: 1024px) 480px, (min-width: 640px) 50vw, 100vw"
    />
  </div>
  <div class="tarjeta__texto">
    <p class="tarjeta__fig rotulo rotulo--acento">
      {/* Dos renglones apilados: en hover, «FIG. 03» sube y deja ver «FIG. 03 → ABRIR LÁMINA». */}
      <span class="tarjeta__rodillo">
        <span>{fig}</span>
        <span aria-hidden="true">
          {fig} → {t(lang, 'card.open')}
        </span>
      </span>
      <span>{formatMonth(data.date)}</span>
    </p>
    <Titulo class="tarjeta__titulo">
      <a href={projectUrl(lang, slug)}>{data.title}</a>
    </Titulo>
    <p class="tarjeta__resumen">{data.summary}</p>
    <p class="tarjeta__cats">{data.categories.map((id) => getCategory(id)?.name[lang]).join(' · ')}</p>
  </div>
</article>

<style>
  .tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .tarjeta__foto {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    transition:
      outline-offset var(--t-hover) var(--ease-out),
      outline-color var(--t-hover) var(--ease-out);
  }
  .tarjeta__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform calc(var(--t-hover) * 2) var(--ease-out);
  }
  .tarjeta__texto {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding-top: 6px;
  }
  .tarjeta__fig {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    font-size: 11px;
  }
  /* Rodillo: muestra un renglón por vez; el segundo queda escondido abajo. */
  .tarjeta__rodillo {
    display: flex;
    flex-direction: column;
    height: 1.55em;
    overflow: hidden;
  }
  .tarjeta__rodillo > span {
    flex: none;
    height: 1.55em;
    white-space: nowrap;
    transition: transform var(--t-hover) var(--ease-out);
  }
  .tarjeta__titulo {
    font-size: 24px;
    line-height: 1.22;
    font-weight: 600;
  }
  /* El link del título cubre toda la tarjeta. No lleva subrayado: cambia de color. */
  .tarjeta__titulo a { background-image: none; }
  .tarjeta__titulo a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .tarjeta__titulo a:focus-visible { outline: none; }
  .tarjeta__resumen { font-size: 16px; }
  .tarjeta__cats {
    font-size: var(--fs-small);
    color: var(--c-ink-muted);
  }
  .tarjeta--chica .tarjeta__texto {
    gap: 6px;
    padding-top: 4px;
  }
  .tarjeta--chica .tarjeta__titulo {
    font-size: var(--fs-h3);
    line-height: 1.25;
  }
  .tarjeta--chica .tarjeta__resumen { font-size: 15px; }

  /* --- Con foco de teclado: el marco se despega y pasa a acento, la foto se acerca
     un poco, el rótulo cambia y el título pasa a acento. La tarjeta entera NO se escala. --- */
  .tarjeta:has(a:focus-visible) .tarjeta__foto {
    outline-offset: var(--frame-offset-hover);
    outline-color: var(--c-accent);
  }
  .tarjeta:has(a:focus-visible) .tarjeta__foto :global(img) { transform: scale(1.03); }
  .tarjeta:has(a:focus-visible) .tarjeta__rodillo > span { transform: translateY(-100%); }

  /* --- Lo mismo con el mouse encima (en pantallas táctiles no hay hover: se navega directo) --- */
  @media (hover: hover) {
    .tarjeta:hover .tarjeta__foto {
      outline-offset: var(--frame-offset-hover);
      outline-color: var(--c-accent);
    }
    .tarjeta:hover .tarjeta__foto :global(img) { transform: scale(1.03); }
    .tarjeta:hover .tarjeta__rodillo > span { transform: translateY(-100%); }
    .tarjeta:hover .tarjeta__titulo a { color: var(--c-accent); }
  }
</style>
