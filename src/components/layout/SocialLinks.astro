---
// Links a redes. Las direcciones salen de src/config/site.ts.
// Una red sin dirección no se muestra.
import { site, type Lang } from '../../config/site';
import { t } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const redes = Object.entries(site.social).filter(([, url]) => url);
---

<ul class="social" aria-label={t(lang, 'footer.social')}>
  {
    redes.map(([nombre, url]) => (
      <li>
        <a href={url} rel="me noopener">
          {nombre}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--s-7);
    font-family: var(--f-mono);
    text-transform: uppercase;
  }
  a,
  span {
    display: inline-flex;
    align-items: center;
  }
  a {
    min-height: 44px;
    --ul-y: calc(50% + 0.8em);
  }
  .marcador { font-size: inherit; letter-spacing: inherit; }
</style>
