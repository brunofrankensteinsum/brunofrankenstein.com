---
// Header del sitio: marca, navegación, selector de idioma y, en pantallas chicas,
// el botón que abre el menú a pantalla completa.
import Icon from '../ui/Icon.astro';
import LangSwitch from './LangSwitch.astro';
import SocialLinks from './SocialLinks.astro';
import { site, type Lang } from '../../config/site';
import { pageUrl, type PageKey } from '../../config/routes';
import { t } from '../../i18n/ui';

interface Props {
  lang: Lang;
  // Sección actual, para marcarla en la navegación.
  section?: PageKey;
  alternateUrl?: string;
}

const { lang, section, alternateUrl } = Astro.props;

// Las cinco secciones, en el orden del menú.
const items: PageKey[] = ['home', 'projects', 'experience', 'about', 'contact'];
---

<header class="header" data-header>
  <div class="header__inner">
    <a class="header__brand" href={pageUrl(lang, 'home')}>{site.brand}</a>

    <nav class="header__nav" aria-label={t(lang, 'nav.label')}>
      {
        items.map((item) => (
          <a href={pageUrl(lang, item)} aria-current={item === section ? 'page' : undefined}>
            {t(lang, `nav.${item}`)}
          </a>
        ))
      }
    </nav>

    <LangSwitch lang={lang} alternateUrl={alternateUrl} />

    <button
      class="header__menu-btn"
      type="button"
      aria-label={t(lang, 'menu.open')}
      aria-expanded="false"
      aria-controls="menu"
      data-menu-open
    >
      <Icon name="ui-menu" />
    </button>
  </div>
</header>

<!-- Menú de pantallas chicas. <dialog> ya trae de fábrica: cerrar con Esc,
     no dejar salir el foco del panel y devolver el foco al botón al cerrar. -->
<dialog class="menu" id="menu" aria-label={t(lang, 'menu.label')}>
  <div class="menu__bar">
    <a class="header__brand" href={pageUrl(lang, 'home')}>{site.brand}</a>
    <button class="header__menu-btn menu__close" type="button" aria-label={t(lang, 'menu.close')} data-menu-close autofocus>
      {/* Tres líneas que giran hasta formar una ×. Va dibujado acá (y no con <Icon>) para poder animar cada línea. */}
      <svg class="hamb" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true">
        <path class="hamb__a" d="M3 6h18"></path>
        <path class="hamb__b" d="M3 12h18"></path>
        <path class="hamb__c" d="M3 18h18"></path>
      </svg>
    </button>
  </div>

  <nav class="menu__nav" aria-label={t(lang, 'nav.label')}>
    <ol class="menu__list">
      {
        items.map((item, i) => (
          <li>
            <a href={pageUrl(lang, item)} aria-current={item === section ? 'page' : undefined}>
              <span class="menu__num">{String(i + 1).padStart(2, '0')}</span>
              {t(lang, `nav.${item}`)}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="menu__foot">
    <LangSwitch lang={lang} alternateUrl={alternateUrl} />
    <SocialLinks lang={lang} />
  </div>
</dialog>

<script>
  // 1) Header compacto: al bajar más de 80 px pasa de 64 a 52 px de alto.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const actualizar = () => header.toggleAttribute('data-compact', window.scrollY > 80);
    window.addEventListener('scroll', actualizar, { passive: true });
    actualizar();
  }

  // 2) Menú de pantallas chicas.
  const menu = document.querySelector<HTMLDialogElement>('#menu');
  const abrir = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const cerrar = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  if (menu && abrir && cerrar) {
    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Al cerrar, primero la × vuelve a ser tres líneas (200 ms) y después se cierra el panel.
    const cerrarMenu = () => {
      if (!menu.open || menu.hasAttribute('data-cerrando')) return;
      if (sinMovimiento.matches) {
        menu.close();
        return;
      }
      menu.setAttribute('data-cerrando', '');
      window.setTimeout(() => {
        menu.removeAttribute('data-cerrando');
        menu.close();
      }, 200);
    };

    abrir.addEventListener('click', () => {
      menu.showModal();
      abrir.setAttribute('aria-expanded', 'true');
    });
    cerrar.addEventListener('click', cerrarMenu);
    // "cancel" es la tecla Esc: se frena el cierre inmediato para animarlo igual que el botón.
    menu.addEventListener('cancel', (e) => {
      e.preventDefault();
      cerrarMenu();
    });
    menu.addEventListener('close', () => abrir.setAttribute('aria-expanded', 'false'));
    // Si la ventana se agranda hasta el tamaño de escritorio, el menú se cierra solo.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches && menu.open) menu.close();
    });
  }

  // 3) Cambio de idioma: si se pasa a la misma página en el otro idioma, se conserva
  //    la altura del scroll (en proporción, porque los textos no miden lo mismo).
  const CLAVE = 'bf-scroll';
  const alto = () => document.documentElement.scrollHeight - window.innerHeight;
  document.querySelectorAll<HTMLAnchorElement>('.lang a[hreflang]').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        const proporcion = alto() > 0 ? window.scrollY / alto() : 0;
        sessionStorage.setItem(CLAVE, JSON.stringify({ ruta: link.pathname, proporcion }));
      } catch {
        // Sin almacenamiento disponible, simplemente no se conserva el scroll.
      }
    });
  });
  try {
    const guardado = sessionStorage.getItem(CLAVE);
    if (guardado) {
      sessionStorage.removeItem(CLAVE);
      const { ruta, proporcion } = JSON.parse(guardado);
      if (ruta === window.location.pathname && proporcion > 0) {
        window.scrollTo({ top: proporcion * alto(), behavior: 'instant' });
      }
    }
  } catch {
    // Ídem.
  }
</script>

<style>
  /* ---------- Barra ---------- */
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--c-paper);
    border-bottom: 1px solid var(--c-line);
    font-family: var(--f-mono);
    font-size: 13px;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
  }
  .header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--s-4);
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--bar-pad);
    min-height: 48px;
    transition: min-height var(--t-hover) var(--ease-out);
  }
  .header__brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-right: auto;
    /* Altura del subrayado: justo debajo del texto, no al pie de la caja de 44 px. */
    --ul-y: calc(50% + 0.8em);
  }

  /* ---------- Navegación ---------- */
  /* Sin JavaScript, en pantallas chicas la navegación queda a la vista en una
     segunda fila. Con JavaScript (clase .js en <html>) se reemplaza por el botón de menú. */
  .header__nav {
    order: 3;
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-5);
    width: 100%;
    border-top: 1px dashed var(--c-line);
  }
  .header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    --ul-y: calc(50% + 0.8em);
  }

  .header__menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -10px; /* alinea el ícono con el margen de la página */
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
  }
  :global(.js) .header__nav { display: none; }
  :global(.js) .header__menu-btn { display: inline-flex; }

  @media (min-width: 640px) {
    .header__inner { min-height: 64px; }
    .header[data-compact] .header__inner { min-height: 52px; }
  }

  /* Escritorio: todo en una fila, sin botón de menú. */
  @media (min-width: 1024px) {
    .header__inner {
      flex-wrap: nowrap;
      column-gap: var(--s-10);
    }
    .header__brand { margin-right: 0; }
    .header__nav,
    :global(.js) .header__nav {
      order: 0;
      display: flex;
      flex-wrap: nowrap;
      flex-grow: 1;
      column-gap: var(--s-7);
      width: auto;
      border-top: none;
    }
    :global(.js) .header__menu-btn { display: none; }
  }

  /* ---------- Menú a pantalla completa ---------- */
  .menu {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    color: var(--c-ink);
    font-family: var(--f-mono);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    background-color: var(--c-paper);
    background-image:
      linear-gradient(var(--c-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--c-grid) 1px, transparent 1px);
    background-size: var(--grid-size) var(--grid-size);
  }
  .menu[open] {
    display: flex;
    flex-direction: column;
  }
  .menu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    padding-inline: var(--bar-pad);
    background: var(--c-paper);
    border-bottom: 1px solid var(--c-line);
    font-size: 13px;
  }
  .menu__close { display: inline-flex; }

  /* Las tres líneas giran hasta formar una × en 200 ms.
     @starting-style dice desde dónde arranca la animación cuando el menú recién se abre. */
  .hamb path {
    transform-box: view-box;
    transform-origin: center;
    transition:
      transform var(--t-hover) var(--ease-out),
      opacity var(--t-hover) linear;
  }
  .menu[open] .hamb__a { transform: translateY(6px) rotate(45deg); }
  .menu[open] .hamb__b { opacity: 0; }
  .menu[open] .hamb__c { transform: translateY(-6px) rotate(-45deg); }
  @starting-style {
    .menu[open] .hamb__a,
    .menu[open] .hamb__c { transform: none; }
    .menu[open] .hamb__b { opacity: 1; }
  }
  .menu[open][data-cerrando] .hamb__a,
  .menu[open][data-cerrando] .hamb__c { transform: none; }
  .menu[open][data-cerrando] .hamb__b { opacity: 1; }

  .menu__nav {
    flex: 1;
    overflow-y: auto;
    padding: var(--s-8) var(--bar-pad);
  }
  .menu__list a {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    min-height: 60px;
    padding-block: var(--s-3);
    border-bottom: 1px dashed var(--c-line);
    font-size: 24px;
    letter-spacing: 0.04em;
    /* Estos renglones ya tienen su línea punteada: no llevan subrayado. */
    background-image: none;
  }
  .menu__num {
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    color: var(--c-ink-muted);
  }
  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-6);
    min-height: 64px;
    padding: var(--s-2) var(--bar-pad);
    background: var(--c-paper);
    border-top: 1px solid var(--c-line);
    font-size: 13px;
  }
  @media (min-width: 640px) {
    .menu__bar { min-height: 64px; }
  }
</style>
