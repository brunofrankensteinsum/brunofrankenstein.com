---
// Layout base: la estructura común a todas las páginas (header, contenido, footer).
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/interacciones.css';
import Head from '../components/seo/Head.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import type { Lang } from '../config/site';
import type { PageKey } from '../config/routes';
import { t } from '../i18n/ui';
import { marcarJs, prepararEntrada } from '../scripts/en-linea.mjs';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  // Sección a la que pertenece la página, para marcarla en la navegación.
  section?: PageKey;
  // URL de esta misma página en el otro idioma. Si no existe, se enlaza al inicio.
  alternateUrl?: string;
  // true = pedirle a los buscadores que no guarden esta página.
  noindex?: boolean;
  // "article" para un proyecto; "website" para el resto.
  type?: 'website' | 'article';
  // Datos estructurados y imagen para compartir: se pasan tal cual a Head.astro.
  jsonld?: object;
  image?: string;
}

const { lang, title, description, section, alternateUrl, noindex, type, jsonld, image } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0C2340" />
    <Head lang={lang} title={title} description={description} alternateUrl={alternateUrl} noindex={noindex} type={type} jsonld={jsonld} image={image} />
    <!-- Baja antes que nada la fuente del texto, para que no «salte» al cargar. -->
    <link rel="preload" href="/fonts/InstrumentSans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Marca que hay JavaScript: el CSS lo usa para cambiar la navegación por el botón de menú. -->
    <script is:inline set:html={marcarJs} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t(lang, 'skip')}</a>
    <Header lang={lang} section={section} alternateUrl={alternateUrl} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    {/* Prepara el movimiento de entrada antes de que la página se pinte. El texto del script
        está en src/scripts/en-linea.mjs, junto con la explicación. */}
    <script is:inline set:html={prepararEntrada} />
    <script>
      import '../scripts/nota.ts';
      import '../scripts/entrada.ts';
    </script>
  </body>
</html>

<style>
  /* El contenido recibe el foco al usar «Saltar al contenido», pero sin dibujar un marco. */
  main:focus { outline: none; }
</style>
